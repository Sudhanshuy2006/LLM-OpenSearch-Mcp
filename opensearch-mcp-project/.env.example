# Copy to .env and edit.  cp .env.example .env

# ---- OpenSearch ----------------------------------------------------------
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=StrongPass@2026
OPENSEARCH_VERIFY_CERTS=false      # local docker uses a self-signed cert

# ---- MCP server ----------------------------------------------------------
# official = uvx opensearch-mcp-server-py   (the upstream server; needs uvx)
# local    = poc/local_mcp_server.py        (bundled in this repo, no uvx)
MCP_SERVER_MODE=local

# Restrict which of the server's tools are exposed to the model.
OPENSEARCH_ENABLED_TOOLS=ListIndexTool,IndexMappingTool,SearchIndexTool,GetIndexStatsTool

# ---- LLM -----------------------------------------------------------------
# rules = no API key, deterministic planner (works offline)
# anthropic | openai | groq | xai
LLM_PROVIDER=rules
# LLM_MODEL=

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...

# ---- Demo mode -----------------------------------------------------------
# true = use the in-memory engine instead of a real cluster (no Docker needed)
DEMO_MODE=false
